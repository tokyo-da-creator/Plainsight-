{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node build.mjs",
  "outputDirectory": "public",
  "functions": {
    "api/intel.mjs": {
      "maxDuration": 60
    },
    "api/reader.mjs": {
      "maxDuration": 30
    },
    "api/og.mjs": {
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/reader",
      "destination": "/api/reader"
    },
    {
      "source": "/og",
      "destination": "/api/og"
    },
    {
      "source": "/api/:set(kev|cves|ransomware|news|politics|votes|sports|who)",
      "destination": "/api/intel?set=:set"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}